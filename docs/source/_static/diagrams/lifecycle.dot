// Calculation lifecycle
// Generated by docs/diagrams/generate.py — do not edit by hand.
digraph G {
  bgcolor="transparent"; rankdir="TB"; nodesep=0.4; ranksep="0.45";
  fontname="Helvetica,Arial,sans-serif"; fontsize="10";
  node [fontname="Helvetica,Arial,sans-serif", fontsize="10", fontcolor="#1b1f24", margin="0.14,0.08"];
  edge [fontname="Helvetica,Arial,sans-serif"];
  subgraph cluster_local { label="1. Your machine (or the daemon worker)"; fontsize="10"; color="#7a8290"; fontcolor="#7a8290"; style="dashed";
  inputs [label="inputs\nparameters, code, skf_files, ...", style="filled", fillcolor="#d6f0da", color="#2e8b57", shape="oval"];
  submit [label="engine.submit()\nor engine.run()", style="filled", fillcolor="#e4e7eb", color="#5b6672", shape="box3d"];
  prepare [label="DftbPlusCalculation\n.prepare_for_submission()", style="rounded,filled", fillcolor="#cfe3fb", color="#1f6fd0", shape="box", penwidth="2.4"];
  sandbox [label="sandbox folder\ndftb_in.hsd, mat_files", style="filled", fillcolor="#fdefc6", color="#b8860b", shape="note"];
  calcinfo [label="CalcInfo\nretrieve_list, local_copy_list", style="filled", fillcolor="#e4e7eb", color="#5b6672", shape="box3d"];
  }
  subgraph cluster_remote { label="2. The compute resource"; fontsize="10"; color="#7a8290"; fontcolor="#7a8290"; style="dashed";
  workdir [label="remote working directory\ndftb_in.hsd + *.skf", style="filled", fillcolor="#fdefc6", color="#b8860b", shape="note"];
  dftb [label="dftb+", style="filled", fillcolor="#e6dcf5", color="#6b46c1", shape="hexagon"];
  outfiles [label="dftb.out, detailed.out,\nband.out, geom.out.*, ...", style="filled", fillcolor="#fdefc6", color="#b8860b", shape="note"];
  }
  subgraph cluster_parse { label="3. Back in the database"; fontsize="10"; color="#7a8290"; fontcolor="#7a8290"; style="dashed";
  retrieved [label="retrieved\n(FolderData)", style="filled", fillcolor="#d6f0da", color="#2e8b57", shape="oval"];
  parse [label="DftbPlusParser.parse()", style="rounded,filled", fillcolor="#cfe3fb", color="#1f6fd0", shape="box", penwidth="2.4"];
  outparams [label="output_parameters\n(Dict)", style="filled", fillcolor="#d6f0da", color="#2e8b57", shape="oval"];
  exit [label="exit code\n0 / 300 / 310 / 320 / 330", style="filled", fillcolor="#e4e7eb", color="#5b6672", shape="box3d"];
  }
  inputs -> submit [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid"];
  submit -> prepare [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid", label="engine calls the plugin"];
  prepare -> sandbox [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid", label="writes"];
  prepare -> calcinfo [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid", label="returns"];
  calcinfo -> workdir [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid", label="upload + local_copy_list"];
  sandbox -> workdir [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid", label="upload"];
  workdir -> dftb [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid", label="scheduler runs"];
  dftb -> outfiles [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid", label="stdout to dftb.out"];
  outfiles -> retrieved [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid", label="retrieve_list"];
  retrieved -> parse [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid"];
  parse -> outparams [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid", label="self.out()"];
  parse -> exit [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid", label="return"];
  subgraph cluster_legend {
    label="Legend"; fontsize="9"; fontname="Helvetica,Arial,sans-serif";
    color="#7a8290"; fontcolor="#7a8290"; style="dashed";
    rank="same";
    cluster_legend_0 [label="AiiDA Data node", style="filled", fillcolor="#d6f0da", color="#2e8b57", shape="oval"];
    cluster_legend_1 [label="plugin code", style="rounded,filled", fillcolor="#cfe3fb", color="#1f6fd0", shape="box"];
    cluster_legend_0 -> cluster_legend_1 [style="invis"];
    cluster_legend_2 [label="file on disk", style="filled", fillcolor="#fdefc6", color="#b8860b", shape="note"];
    cluster_legend_1 -> cluster_legend_2 [style="invis"];
    cluster_legend_3 [label="external binary", style="filled", fillcolor="#e6dcf5", color="#6b46c1", shape="hexagon"];
    cluster_legend_2 -> cluster_legend_3 [style="invis"];
    cluster_legend_4 [label="AiiDA machinery", style="filled", fillcolor="#e4e7eb", color="#5b6672", shape="box3d"];
    cluster_legend_3 -> cluster_legend_4 [style="invis"];
  }
}
