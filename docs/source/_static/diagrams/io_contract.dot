// Input/output node contract
// Generated by docs/diagrams/generate.py — do not edit by hand.
digraph G {
  bgcolor="transparent"; rankdir="LR"; nodesep=0.2; ranksep="0.45";
  fontname="Helvetica,Arial,sans-serif"; fontsize="10";
  node [fontname="Helvetica,Arial,sans-serif", fontsize="10", fontcolor="#1b1f24", margin="0.14,0.08"];
  edge [fontname="Helvetica,Arial,sans-serif"];
  subgraph cluster_in { label="Inputs"; fontsize="10"; color="#7a8290"; fontcolor="#7a8290"; style="dashed";
  code [label="code : InstalledCode\nrequired", style="filled", fillcolor="#d6f0da", color="#2e8b57", shape="oval"];
  parameters [label="parameters : Dict\nexactly one of these two", style="filled,dashed", fillcolor="#d6f0da", color="#2e8b57", shape="oval"];
  dftb_input [label="dftb_input : SinglefileData\nexactly one of these two", style="filled,dashed", fillcolor="#d6f0da", color="#2e8b57", shape="oval"];
  skf [label="skf_files : FolderData\noptional", style="filled,dashed", fillcolor="#d6f0da", color="#2e8b57", shape="oval"];
  mat [label="mat_files : FolderData\noptional", style="filled,dashed", fillcolor="#d6f0da", color="#2e8b57", shape="oval"];
  structure [label="structure : Dict\noptional, provenance only", style="filled,dashed", fillcolor="#d6f0da", color="#2e8b57", shape="oval"];
  remote_flag [label="use_remote_skf_path : Bool\ndefault False", style="filled", fillcolor="#d6f0da", color="#2e8b57", shape="oval"];
  prefix_flag [label="fix_output_prefix : Bool\ndefault True", style="filled", fillcolor="#d6f0da", color="#2e8b57", shape="oval"];
  metadata [label="metadata.options\nresources, walltime, parser_name", style="filled", fillcolor="#e4e7eb", color="#5b6672", shape="box3d"];
  }
  calc [label="DftbPlusCalculation", style="filled", fillcolor="#ffe0cc", color="#c2571a", shape="box", penwidth="2.4"];
  subgraph cluster_out { label="Outputs"; fontsize="10"; color="#7a8290"; fontcolor="#7a8290"; style="dashed";
  remote_folder [label="remote_folder : RemoteData\nalways", style="filled", fillcolor="#d6f0da", color="#2e8b57", shape="oval"];
  retrieved [label="retrieved : FolderData\nalways", style="filled", fillcolor="#d6f0da", color="#2e8b57", shape="oval"];
  output_parameters [label="output_parameters : Dict\nonly on exit code 0", style="filled,dashed", fillcolor="#d6f0da", color="#2e8b57", shape="oval"];
  }
  code -> calc [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid"];
  parameters -> calc [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid", label="or"];
  dftb_input -> calc [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid"];
  skf -> calc [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid"];
  mat -> calc [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid"];
  structure -> calc [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid"];
  remote_flag -> calc [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid"];
  prefix_flag -> calc [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid"];
  metadata -> calc [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid"];
  calc -> remote_folder [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid"];
  calc -> retrieved [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid"];
  calc -> output_parameters [color="#7a8290", fontcolor="#7a8290", fontsize="9", style="solid"];
  // dashed border = optional
}
